# Copy to .env and adjust. compose.yaml reads this file automatically.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=bpd.settings.dev
SECRET_KEY=django-insecure-dev-only-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# ── CARTO (community map basemap tiles) ────────────────────────────────────
# Get a key at https://app.carto.com/ -> Developers -> API keys.
CARTO_API_KEY=

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=bpd
POSTGRES_PASSWORD=bpd
POSTGRES_DB=bpd
POSTGRES_PORT=5432
# Set explicitly when running manage.py outside Docker:
# DATABASE_URL=postgres://bpd:bpd@localhost:5432/bpd

# ── Valkey ────────────────────────────────────────────────────────────────
VALKEY_PORT=6379
# VALKEY_URL=redis://localhost:6379/0

WEB_PORT=8000

# ── Media storage (production) ────────────────────────────────────────────
# Leave AWS_STORAGE_BUCKET_NAME empty to keep media on the local filesystem.
# Set it to switch Wagtail images/documents to S3-compatible object storage.
# AWS_STORAGE_BUCKET_NAME=blackpythondevs-media
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# For Cloudflare R2 / Backblaze / MinIO, point at their endpoint:
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# Serve media from a CDN hostname:
# AWS_S3_CUSTOM_DOMAIN=media.blackpythondevs.com

# ── Accounts (django-allauth, passwordless) ───────────────────────────────
# Members sign up with an email address and sign in with an emailed code.
# ACCOUNT_EMAIL_VERIFICATION must stay "mandatory" for code-based signup.
ACCOUNT_EMAIL_VERIFICATION=mandatory
# ACCOUNT_LOGIN_BY_CODE_TIMEOUT=600

# ── Discord (connect-only, grants the community messaging role) ───────────
# Register an application at https://discord.com/developers/applications,
# add the redirect URL <base>/accounts/discord/login/callback/, and create a
# SocialApp in the CMS (Snippets → Social applications) with the client id/secret.
# For automatic server join + role grant, invite a bot with Manage Roles and
# set all three below. Its role must sit ABOVE the member role in the server.
DISCORD_CLIENT_ID=<DISCORD_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_SECRET>

# for the auto-role bot (leave blank to skip role granting)
# TODO: Update documentation on how to connect to discord
DISCORD_GUILD_ID=<DISCORD_GUILD_ID>
DISCORD_BOT_TOKEN=<DISCORD BOT TOKEN>
DISCORD_MEMBER_ROLE_ID=<DISCORD_MEMBER_ROLE_ID>
# DISCORD_GUILD_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_MEMBER_ROLE_ID=
DISCORD_INVITE_URL=<DISCORD_INVITE_URL>

# ── Email (production) ────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@blackpythondevs.org
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
