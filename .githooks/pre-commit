#!/usr/bin/env bash
# Blocks commits that introduce secrets. Enable with `mise run install-hooks`.
set -euo pipefail

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaks not found on PATH — run 'mise install' first." >&2
  exit 1
fi

betterleaks git --staged --verbose --redact --confidence medium
