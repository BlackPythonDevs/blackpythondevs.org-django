# The variable names production reads. The real values live in fnox.toml
# (age-encrypted, gitignored) and are injected by `fnox exec --`; set one with
# `fnox set NAME`. Never commit real values.
#
#   mise run prod-deploy
#
# DEBUG is not listed here on purpose: bpd/settings/production.py hardcodes
# DEBUG = False, so it cannot be switched on from the environment.

# ── Site ──────────────────────────────────────────────────────────────────
# Sets the certificate domain, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, and
# WAGTAILADMIN_BASE_URL. www.<DOMAIN> is redirected to the apex. These two
# default to the live values in compose.prod.yaml; override for staging.
DOMAIN=blackpythondevs.org
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=contact@blackpythondevs.org
# Leave unset in production. Set to "tls internal" only for a local dry run,
# where Caddy self-signs instead of requesting a real certificate.
# CADDY_TLS_INTERNAL=tls internal

# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=

# ── CARTO (community map basemap tiles) ────────────────────────────────────
# Get a key at https://app.carto.com/ -> Developers -> API keys.
CARTO_API_KEY=

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=bpd
POSTGRES_DB=bpd
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Email (sign-in codes go through this; allauth is passwordless) ────────
DEFAULT_FROM_EMAIL=noreply@blackpythondevs.org
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Media storage ─────────────────────────────────────────────────────────
# Leave the bucket empty to keep uploads on the media_data volume, which Caddy
# serves at /media. Set it to move Wagtail images and documents to S3-compatible
# object storage instead.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.blackpythondevs.org

# ── Discord ───────────────────────────────────────────────────────────────
# The OAuth redirect URL must be https://<DOMAIN>/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_MEMBER_ROLE_ID=
DISCORD_INVITE_URL=https://discord.gg/XUc3tFqCT3
