# Caddy terminates TLS for the production stack. Certificates are issued and
# renewed automatically from Let's Encrypt, so there is nothing to cron.
#
# Requirements: DNS A/AAAA records for {$DOMAIN} (and www) point at this host,
# and ports 80 and 443 are reachable from the internet. Port 80 must stay open
# after the first issuance — renewals use it too.

{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	{$CADDY_TLS_INTERNAL}
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Empty by default (real Let's Encrypt certificates). Set
	# CADDY_TLS_INTERNAL="tls internal" for a local dry run under the real
	# hostname: Caddy signs with its own CA and never contacts Let's Encrypt,
	# so a failed validation cannot burn the 5-per-hour rate limit.
	{$CADDY_TLS_INTERNAL}

	encode zstd gzip

	# Wagtail images and documents live on a shared volume when object storage
	# is not configured. With AWS_STORAGE_BUCKET_NAME set, MEDIA_URL points at
	# the bucket instead and this block simply goes unused.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# The Django and Wagtail admins are reachable over the tailnet only — see
	# the :8080 block below. Refusing them here means a leaked session cookie or
	# a stolen sign-in code still buys nothing from the public internet.
	#
	# 404 rather than 403: an unauthenticated scanner learns nothing about
	# whether the path exists or where it moved to.
	@admin path /cms /cms/* /django-admin /django-admin/*
	handle @admin {
		respond "Not Found" 404
	}

	handle {
		# reverse_proxy sets X-Forwarded-Proto, which Django reads through
		# SECURE_PROXY_SSL_HEADER to know the request arrived over HTTPS.
		reverse_proxy web:8000
	}

	log {
		output stdout
	}
}

# ── Tailnet origin ────────────────────────────────────────────────────────
# The tailscale sidecar terminates TLS for <hostname>.<tailnet>.ts.net and
# proxies plaintext here. This port is never published to the host, so the only
# way in is from another container on the compose network — in practice, the
# sidecar. That is what makes the admin paths tailnet-only: they are served
# here and refused in the public block above.
#
# Going through Caddy rather than straight to web:8000 keeps /media working,
# which the Wagtail image chooser needs when uploads live on the volume.
:8080 {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		# Tailscale already terminated TLS. Without this, Caddy would forward
		# X-Forwarded-Proto: http and Django's SECURE_SSL_REDIRECT would send
		# the client into a redirect loop.
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output stdout
	}
}
